            <section class="intro section-pad" id="opportunity">
                <div class="section-kicker">
                    <span>01</span>
                    <p>The opportunity</p>
                </div>
                <div class="intro-copy">
                    <h2>
                        A market that rewards <em>conviction.</em>
                    </h2>
                    <p class="lede">Where conviction meets a repeatable, disciplined process — and where considered decisions matter more than market noise.</p>
                </div>
                <div class="principle-grid">
                    <article>
                        <span>01</span>
